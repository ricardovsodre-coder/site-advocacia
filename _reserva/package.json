{
  "name": "site-advocacia-dual",
  "version": "1.0.0",
  "description": "Dual law-firm sites (desktop + mobile) from shared design system",
  "type": "module",
  "scripts": {
    "dev:desktop": "astro dev --config astro.config.desktop.mjs",
    "dev:mobile": "astro dev --config astro.config.mobile.mjs --port 4322",
    "build:desktop": "astro build --config astro.config.desktop.mjs",
    "build:mobile": "astro build --config astro.config.mobile.mjs",
    "build:all": "npm run build:desktop && npm run build:mobile",
    "preview:desktop": "astro preview --config astro.config.desktop.mjs",
    "preview:mobile": "astro preview --config astro.config.mobile.mjs",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "sync-tokens": "tsx generators/sync-tokens.ts",
    "create:area": "tsx generators/create-content.ts area",
    "create:article": "tsx generators/create-content.ts article",
    "create:faq": "tsx generators/create-content.ts faq",
    "create:case": "tsx generators/create-content.ts case",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write ."
  },
  "dependencies": {
    "astro": "^4.16.0",
    "@astrojs/react": "^3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vercel": "^7.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@google/generative-ai": "^0.20.0",
    "@vercel/kv": "^2.0.0",
    "gsap": "^3.12.5",
    "@gsap/react": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.8",
    "date-fns": "^4.1.0",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "@astrojs/check": "^0.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0"
}