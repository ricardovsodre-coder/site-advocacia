// templates/mobile/MobileContact.astro — Contato mobile simplificado
---
import { cn } from '@design-system/utils/cn';
import { formatWhatsAppLink, formatPhone } from '@design-system/utils/formatters';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const whatsappHref = formatWhatsAppLink('15988033000');
const phoneHref = 'tel:+5515988033000';
const emailHref = 'mailto:escritorio@verissimosodre.com.br';
---

<section class={cn('px-4 py-10 bg-neutral-50', className)} aria-labelledby="mobile-contact-heading">
  <div class="max-w-screen-xl mx-auto">
    <header class="text-center mb-8">
      <h2 id="mobile-contact-heading" class="text-xl font-bold text-neutral-900 mb-2">
        Fale agora
      </h2>
      <p class="text-neutral-600 text-sm">
        Escolha a melhor forma para você
      </p>
    </header>

    <div class="space-y-4">
      {/* WhatsApp - Principal */}
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-[#25D366] text-white font-semibold text-base hover:bg-[#1EBE5A] transition-colors shadow-lg"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.864-2.03-.967-.273-.103-.472-.148-.67.152-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.48-1.653-1.68-.173-.2-.028-.318.15-.418.173-.099.347-.223.596-.424.247-.199.547-.471.596-.545.05-.077.027-.132-.025-.177-.1-.097-.27-.17-1.142-.68-.872-.51-1.805-1.21-2.218-1.472-.414-.26-.794-.497-1.249-.723-.454-.224-.93-.47-1.27-.6-.34-.13-.695-.264-.958-.264-.277 0-.512.13-.752.373-.237.24-.447.613-.488.83-.04.214-.09.407-.123.585-.04.184-.12.363-.19.527-.07.163-.744 1.872-.974 2.225-.23.352-.524.673-.594.836-.07.164-.284.433-.39.563-.11.13-.28.28-.413.38-.13.1-.277.21-.414.25-.138.04-.554.127-.894.08-.34-.047-.692-.137-1.07-.348-.38-.21-.76-.415-1.117-.653-.356-.237-.71-.482-1.03-.75-.32-.27-.63-.55-.906-.85-.28-.3-.51-.6-.74-.89-.23-.28-.41-.54-.54-.77-.13-.23-.22-.43-.28-.58-.06-.15-.08-.27-.08-.38 0-.13.08-.32.21-.48.13-.16.34-.34.52-.48.18-.14.41-.27.685-.41.274-.14.57-.275.873-.41.303-.135.57-.255.795-.347.225-.09.45-.19.65-.26.2-.07.398-.1.578-.12.18-.02.35-.04.5.01.16.05.305.08.44.03.14.03.28.01.41-.02.13-.11.27-.29.39-.18.12-.36.23-.55.32-.19.09-.38.18-.57.25-.19.07-.38.11-.57.14-.19.03-.48.05-.77.03-.29-.02-.57-.04-.85-.07-.28-.03-.54-.1-.8-.17-.26-.07-.51-.17-.75-.27-.24-.1-.47-.22-.69-.34-.22-.12-.43-.24-.63-.36-.2-.12-.39-.24-.56-.36-.17-.12-.33-.24-.47-.36-.14-.12-.26-.23-.37-.34-.11-.11-.2-.22-.28-.33-.08-.11-.15-.21-.2-.31-.05-.1-.08-.2-.08-.3 0-.1.03-.2.08-.3.05-.1.12-.19.2-.28.08-.09.17-.17.27-.25.1-.08.21-.15.32-.22.11-.07.22-.13.33-.19.11-.06.22-.11.33-.16.11-.05.22-.09.33-.13.11-.04.22-.07.33-.1.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08.11-.03.22-.05.33-.08"/></svg>
        Falar no WhatsApp
      </a>

      {/* Telefone */}
      <a
        href={phoneHref}
        class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-primary-800 text-white font-semibold text-base hover:bg-primary-700 transition-colors"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <div class="text-left">
          <span class="text-xs opacity-80">Ligar para Sorocaba</span>
          <span class="block font-semibold">{formatPhone('15988033000')}</span>
        </div>
      </a>

      {/* E-mail */}
      <a
        href={emailHref}
        class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-white border border-neutral-200 text-neutral-700 font-semibold text-base hover:bg-neutral-50 hover:border-primary-200 transition-colors"
      >
        <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <div class="text-left">
          <span class="text-xs text-neutral-500">E-mail</span>
          <span class="block font-semibold text-sm">escritorio@verissimosodre.com.br</span>
        </div>
      </a>

      {/* Endereço */}
      <a
        href="https://www.google.com/maps/search/?api=1&query=Rua+Vinte+e+Oito+de+Outubro,+215+-+26B+-+Alto+da+Boa+Vista+-+Sorocaba-SP"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-white border border-neutral-200 text-neutral-700 font-medium text-sm hover:bg-neutral-50 hover:border-primary-200 transition-colors"
      >
        <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <div class="text-left">
          <span class="text-xs text-neutral-500">Endereço</span>
          <span class="block font-medium text-sm">Rua 28 de Outubro, 215 - Sorocaba/SP</span>
        </div>
      </a>
    </div>

    {/* Disclaimer */}
    <p class="mt-8 text-center text-xs text-neutral-500 max-w-sm mx-auto">
      Seu caso será recebido com carinho e analisado com atenção técnica, dentro da lei.
    </p>
  </div>
</section>