// templates/mobile/MobileHero.astro — Hero mobile curto e direto
---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class={cn('relative px-4 py-10', className)} aria-labelledby="mobile-hero-heading">
  <div class="max-w-screen-xl mx-auto text-center">
    <h1 id="mobile-hero-heading" class="text-2xl md:text-3xl font-bold text-neutral-900 mb-3 leading-tight">
      Seus direitos não podem esperar
    </h1>
    <p class="text-neutral-600 text-sm md:text-base mb-6 max-w-lg mx-auto">
      Atuamos exclusivamente na defesa de empregados — renda até R$ 5k.
      Sem custo inicial. Só recebemos se você ganhar.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        onclick="document.dispatchEvent(new CustomEvent('open-chat'))"
        class="w-full sm:w-auto btn btn-primary"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        Avaliação Gratuita
