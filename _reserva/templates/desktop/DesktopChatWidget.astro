// templates/desktop/DesktopChatWidget.astro — Chat widget desktop completo (ilha React)
---
import ChatWidget from '@design-system/components/ChatWidget/ChatWidget';
import { cn } from '@design-system/utils/cn';

interface Props {
  isOpen?: boolean;
  class?: string;
}

const { isOpen = false, class: className } = Astro.props;
---

<div class={cn('fixed bottom-6 right-6 z-50', className)}>
  {/* Trigger button */}
  <button
    id="chat-trigger"
    class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-900 to-primary-700 shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
    aria-label="Abrir chat com IA"
    aria-expanded="false"
    onclick="document.dispatchEvent(new CustomEvent('open-chat'))"
  >
    <svg class="w-7 h-7 text-white mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
    <span class="absolute -top-1 -right-1 w-5 h-5 bg-[#25D366] text-white text-xs font-bold rounded-full flex items-center justify-center" aria-label="5 perguntas disponíveis">5</span>
  </button>

  {/* Chat Widget (React Island) */}
  <ChatWidget
    client:visible
    isOpen={isOpen}
    onClose={() => document.dispatchEvent(new CustomEvent('close-chat'))}
    onLogin={() => window.location.href = '/api/auth/google?state=desktop'}
    variant="desktop"
    areaChips={[
      'Verbas rescisórias', 'Horas extras', 'Assédio moral',
      'Sem registro', 'Justa causa', 'Insalubridade',
      'Acidente/doença', 'Rescisão indireta', 'Acordo coletivo'
    ]}
  />
</div>

<script is:inline>
  // Sync trigger button with chat state
  window.addEventListener('chat-open', () => {
    const trigger = document.getElementById('chat-trigger');
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'true');
      trigger.style.display = 'none';
    }
  });

  window.addEventListener('chat-close', () => {
    const trigger = document.getElementById('chat-trigger');
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.style.display = 'flex';
    }
  });
</script>