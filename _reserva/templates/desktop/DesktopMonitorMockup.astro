// templates/desktop/DesktopMonitorMockup.astro — Mockup 3D de monitor mostrando o chat IA
---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('relative', className)} aria-label="Demonstração do chat IA no desktop">
  {/* Monitor 3D */}
  <div class="relative aspect-[16/10] max-w-2xl mx-auto" id="monitor-mockup" aria-hidden="true">
    {/* Screen */}
    <div class="absolute inset-4 bg-neutral-900 rounded-xl overflow-hidden shadow-2xl border border-neutral-800">
      {/* Chat interface preview */}
      <div class="h-full flex flex-col p-4 space-y-4">
        {/* Header */}
        <div class="flex items-center justify-between text-white">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
            </div>
            <span class="font-medium">IA Trabalhista</span>
          </div>
          <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </div>

        {/* Messages */}
        <div class="flex-1 overflow-y-auto space-y-4">
          <div class="flex justify-start">
            <div class="bg-primary-600 text-white rounded-2xl rounded-br-none px-4 py-2 max-w-[80%]">
              <p class="text-sm">Fui demitido sem justa causa há 15 dias, não recebi verbas rescisórias.</p>
            </div>
          </div>
          <div class="flex justify-start">
            <div class="bg-neutral-800 text-neutral-100 rounded-2xl rounded-bl-none px-4 py-2 max-w-[80%] border border-neutral-700">
              <p class="text-sm">Entendo. Na demissão sem justa causa, você tem direito a...</p>
              <ul class="mt-2 space-y-1 text-xs text-neutral-300">
                <li>• Saldo de salário</li>
                <li>• Aviso prévio</li>
                <li>• 13º proporcional</li>
                <li>• Férias + 1/3</li>
                <li>• FGTS + 40%</li>
              </ul>
            </div>
          </div>
          <div class="flex justify-end">
            <div class="bg-primary-600 text-white rounded-2xl rounded-br-none px-4 py-2 max-w-[80%]">
              <p class="text-sm">Como faço para comprovar?</p>
            </div>
          </div>
        </div>

        {/* Input area */}
        <div class="flex gap-2 pt-2 border-t border-neutral-800">
          <input type="text" placeholder="Digite sua pergunta..." class="flex-1 bg-neutral-800 border-neutral-700 rounded-full px-4 py-2 text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-primary-500" disabled />
          <button class="bg-primary-600 text-white rounded-full p-2 hover:bg-primary-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </div>
      </div>
    </div>

    {/* Monitor body */}
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-24 h-2 bg-neutral-800 rounded-b-xl" />
    <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-8 h-1 bg-neutral-700 rounded-full" />
    <div class="absolute bottom-[-8px] left-1/2 -translate-x-1/2 w-32 h-4 bg-neutral-800 rounded-t-xl" />

    {/* Reflection */}
    <div class="absolute inset-4 bg-gradient-to-b from-transparent via-neutral-900/10 to-transparent pointer-events-none" />
  </div>

  {/* Floating label */}
  <div class="mt-8 text-center">
    <p class="text-sm font-medium text-neutral-600">Veja como funciona →</p>
  </div>
</div>